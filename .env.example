# ProductWhisper Frontend — environment template
# Copy to `.env` for local development (`.env` is gitignored).
#
# NOTE: All VITE_* variables are embedded into the public client bundle at build time.
# They are NOT secret. Never put a privileged/admin key here — only values safe to expose
# to the browser. Real authorization must be enforced server-side.

# Base URL for API requests.
# Dev: leave as /api/v1 (Vite proxies it to the backend — see vite.config.ts).
# Prod: set a full URL in .env.production, e.g. https://api.productwhisper.ng/api/v1
VITE_API_URL=/api/v1

# Public client API key (browser-exposed; use a read-only/public-tier key, not the master key).
VITE_API_KEY=pw-dev-key-change-me

# Dev-only: where the Vite dev server proxies /api/v1. Defaults to http://localhost:8000.
# Override if the backend runs on another port (e.g. 8000 is taken by another local service).
# VITE_PROXY_TARGET=http://localhost:8010
