# Production build config (vite build picks this up automatically).
# The dev proxy in vite.config.ts does NOT run in production, so VITE_API_URL
# MUST be a full, publicly reachable backend URL here.
#
# Replace with your real deployed backend origin before shipping:
VITE_API_URL=https://api.productwhisper.ng/api/v1

# Public/read-only client key for production (NOT the backend master key).
VITE_API_KEY=replace-with-public-client-key
